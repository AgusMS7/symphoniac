# Copiar a .env dentro de backend/ para desarrollo local contra PostgreSQL local.
# En Docker el compose inyecta las variables; no hace falta .env.
DB_URL=jdbc:postgresql://127.0.0.1:5432/symphoniac
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_PASSWORD_LOCAL_GENERADA
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
UPLOAD_DIR=public/images
