# Copiar a .env en la raíz de projects/symphoniac. NUNCA commitear .env.
# Compose: usuario y password de Postgres. POSTGRES_PASSWORD solo se aplica
# cuando el volumen se inicializa por primera vez (por eso el brief usa down -v).
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_PASSWORD_DEMO_GENERADA

# Puerto del frontend en el host. Si el 8080 está ocupado, usá 8081.
FRONT_PORT=8081
