# Copiar a .env.local para desarrollo con Vite.
# En Docker no hace falta: el compose pasa estos valores como build args.
# En Vercel: configurar estas MISMAS variables en Project Settings > Environment
# Variables pero con URLs absolutas del backend, p. ej.:
#   VITE_API_URL=https://<backend>/api
#   VITE_IMAGES_URL=https://<backend>/images
VITE_API_URL=/api
VITE_IMAGES_URL=/images

# Demo: activa el backend local (favoritos, carrito y CRUD sobre
# localStorage) manteniendo el catálogo remoto como base de lectura.
# Por defecto false: desarrollo con escrituras reales. Para la demo,
# usar VITE_DEMO=true o `docker compose up` (el compose ya la activa).
VITE_DEMO=false
